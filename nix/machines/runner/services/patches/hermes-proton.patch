+# --------------------------------------------------------------------------
+# non-interactive login
+# --------------------------------------------------------------------------
+#
+# When credentials are supplied through the environment (e.g. by the
+# `protonpass` secret source), the plugin can log itself in instead of relying
+# on an out-of-band `proton account login`. On a session-missing/expired error
+# (exit code 2) we log in once and retry the call.
+#
+# * PROTON_USERNAME / PROTON_PASSWORD — the account login.
+# * PROTON_TOTP_CMD — a command that prints a FRESH 6-digit code. Preferred,
+#   because TOTP codes are only valid for ~30s and a value resolved at process
+#   startup would be stale by the time a login is actually needed.
+# * PROTON_TOTP_SECRET — a static TOTP seed (base32 or `otpauth://` URI) we
+#   generate the code from here. Used only when no command is set.
+# * PROTON_VERIFIED_FILE — path to a one-shot solved-captcha token. When
+#   present it is passed as `--verified` and consumed, mirroring the old
+#   `proton account login` helper.
+
+_USERNAME_ENV = "PROTON_USERNAME"
+_PASSWORD_ENV = "PROTON_PASSWORD"
+_TOTP_CMD_ENV = "PROTON_TOTP_CMD"
+_TOTP_SECRET_ENV = "PROTON_TOTP_SECRET"
+_VERIFIED_FILE_ENV = "PROTON_VERIFIED_FILE"
+
+_TOTP_CODE_RE = re.compile(r"\b(\d{6})\b")
+
+
+def _totp_params(value: str) -> dict[str, Any]:
+    """Parse a TOTP seed: an ``otpauth://`` URI or a bare base32 secret."""
+    value = value.strip()
+    if value.lower().startswith("otpauth://"):
+        query = urllib.parse.parse_qs(urllib.parse.urlparse(value).query)
+        return {
+            "secret": (query.get("secret") or [""])[0],
+            "digits": int((query.get("digits") or ["6"])[0]),
+            "period": int((query.get("period") or ["30"])[0]),
+            "algorithm": (query.get("algorithm") or ["SHA1"])[0],
+        }
+    return {"secret": value, "digits": 6, "period": 30, "algorithm": "SHA1"}
+
+
+def _totp(
+    secret: str,
+    *,
+    digits: int = 6,
+    period: int = 30,
+    algorithm: str = "SHA1",
+    at: float | None = None,
+) -> str:
+    """Generate an RFC 6238 TOTP code from a base32 secret."""
+    key = base64.b32decode(secret.upper() + "=" * (-len(secret) % 8))
+    counter = int((time.time() if at is None else at) // period)
+    digest = hmac.new(
+        key, struct.pack(">Q", counter), getattr(hashlib, algorithm.lower())
+    ).digest()
+    offset = digest[-1] & 0x0F
+    code = struct.unpack(">I", digest[offset : offset + 4])[0] & 0x7FFFFFFF
+    return str(code % (10**digits)).zfill(digits)
+
+
+def _current_totp() -> str | None:
+    """Return a fresh 6-digit TOTP code, or None when none is configured.
+
+    Prefers ``PROTON_TOTP_CMD`` (a command that prints a fresh code) over
+    ``PROTON_TOTP_SECRET`` (a static seed we generate the code from).
+    """
+    cmd = os.environ.get(_TOTP_CMD_ENV, "").strip()
+    if cmd:
+        try:
+            proc = subprocess.run(
+                cmd,
+                shell=True,
+                capture_output=True,
+                text=True,
+                timeout=30,
+                check=False,
+            )
+        except (OSError, subprocess.TimeoutExpired):
+            return None
+        match = _TOTP_CODE_RE.search(proc.stdout or "")
+        return match.group(1) if match else None
+    seed = os.environ.get(_TOTP_SECRET_ENV, "").strip()
+    if not seed:
+        return None
+    try:
+        return _totp(**_totp_params(seed))
+    except (ValueError, TypeError, KeyError):
+        return None
+
+
+def _consume_verified_token() -> str | None:
+    """Read and delete the one-shot solved-captcha token, if present.
+
+    Proton can demand human verification on a fresh login. The operator solves
+    the printed page on any device, writes the retry token to
+    ``PROTON_VERIFIED_FILE``, and the next login attempt consumes it.
+    """
+    path = os.environ.get(_VERIFIED_FILE_ENV, "").strip()
+    if not path:
+        return None
+    try:
+        with open(path) as f:
+            token = f.read().strip()
+    except OSError:
+        return None
+    if not token:
+        return None
+    # Consume it; a deletion failure must never block the login.
+    try:
+        os.remove(path)
+    except OSError:
+        pass
+    return token
+
+
+def credentials_available() -> bool:
+    """True when a username and password are present in the environment."""
+    return bool(
+        os.environ.get(_USERNAME_ENV, "").strip()
+        and os.environ.get(_PASSWORD_ENV, "")
+    )
+
+
+def login() -> None:
+    """Log in non-interactively from environment credentials.
+
+    Raises ProtonError when credentials are missing or the login fails. The
+    password is piped over stdin so it never appears in the process list.
+    """
+    exe = binary()
+    if exe is None:
+        raise ProtonError("proton-cli is not installed.", exit_code=-1)
+    user = os.environ.get(_USERNAME_ENV, "").strip()
+    password = os.environ.get(_PASSWORD_ENV, "")
+    if not user or not password:
+        raise ProtonError(
+            f"no credentials in the environment ({_USERNAME_ENV}/{_PASSWORD_ENV}); "
+            "cannot log in automatically.",
+            exit_code=2,
+        )
+    args = [exe, "account", "login", "--user", user, "--password-stdin", "--no-input"]
+    totp = _current_totp()
+    if totp:
+        args += ["--totp", totp]
+    verified = _consume_verified_token()
+    if verified:
+        args += ["--verified", verified]
+    try:
+        proc = subprocess.run(
+            args,
+            input=password,
+            capture_output=True,
+            text=True,
+            timeout=60,
+            check=False,
+        )
+    except subprocess.TimeoutExpired:
+        raise ProtonError("proton account login timed out", exit_code=5) from None
+    if proc.returncode != 0:
+        detail = (proc.stderr or proc.stdout or "").strip() or "no output"
+        raise ProtonError(
+            f"proton account login failed: {detail}",
+            exit_code=proc.returncode,
+            command="proton account login",
+        )
+
